#!/bin/bash
# Apply or restore a game-only NVIDIA power profile.
#
# This script deliberately never touches the CPU, ASUS platform profile,
# power-profiles-daemon, or the AMD iGPU.  The desktop's CPU/platform tuning is
# left exactly as the user configured it.
#
# Profiles:
#   balanced  NVIDIA auto clocks, default power limit
#   boost     NVIDIA max graphics/memory clocks, default power limit
#   burn      NVIDIA max graphics/memory clocks, maximum power limit
set -u

STATE=/run/game-mode
HOME_DIR="${GAME_MODE_HOME:-/home/gunit}"
PROFILE_FILE="${GAME_MODE_PROFILE_FILE:-$HOME_DIR/.config/game-mode/power-profile}"
MARKER="$STATE/nvidia-original.saved"

mkdir -p "$STATE"

log() {
    logger -t game-mode-perf -- "$*" 2>/dev/null || true
}

read_value() {
    cat "$1" 2>/dev/null || true
}

profile_name() {
    local profile
    profile="$(read_value "$PROFILE_FILE")"
    case "$profile" in
        balanced|boost|burn) printf '%s\n' "$profile" ;;
        *) printf 'boost\n' ;;
    esac
}

save_original() {
    [ -f "$MARKER" ] && return 0
    command -v nvidia-smi >/dev/null 2>&1 || return 0

    nvidia-smi --query-gpu=power.default_limit --format=csv,noheader,nounits \
        2>/dev/null | head -n 1 | tr -d ' ' > "$STATE/orig-nv-power-limit" || true
    : > "$MARKER"
}

reset_nvidia() {
    command -v nvidia-smi >/dev/null 2>&1 || return 0
    nvidia-smi -rgc >/dev/null 2>&1 || true
    nvidia-smi -rmc >/dev/null 2>&1 || true
    nvidia-smi -pm 0 >/dev/null 2>&1 || true
}

set_power_limit() {
    local mode="$1" value

    if [ "$mode" = "max" ]; then
        value="$(nvidia-smi --query-gpu=power.max_limit --format=csv,noheader,nounits \
            2>/dev/null | head -n 1 | tr -d ' ')"
    else
        value="$(read_value "$STATE/orig-nv-power-limit")"
    fi

    if [ -n "$value" ] && [ "$value" != "[N/A]" ]; then
        nvidia-smi -pl "$value" >/dev/null 2>&1 \
            || log "could not set NVIDIA power limit to $value W"
    fi
}

lock_max_clocks() {
    local max_graphics max_memory
    max_graphics="$(nvidia-smi --query-gpu=clocks.max.graphics --format=csv,noheader,nounits 2>/dev/null | head -n 1 | tr -d ' ')"
    max_memory="$(nvidia-smi --query-gpu=clocks.max.memory --format=csv,noheader,nounits 2>/dev/null | head -n 1 | tr -d ' ')"
    nvidia-smi -pm 1 >/dev/null 2>&1 || true
    if [ -n "$max_graphics" ]; then
        nvidia-smi -lgc "$max_graphics,$max_graphics" >/dev/null 2>&1 \
            || log "could not lock NVIDIA graphics clock at $max_graphics MHz"
    fi
    if [ -n "$max_memory" ]; then
        nvidia-smi -lmc "$max_memory,$max_memory" >/dev/null 2>&1 \
            || log "could not lock NVIDIA memory clock at $max_memory MHz"
    fi
}

apply_profile() {
    local profile
    profile="$(profile_name)"
    command -v nvidia-smi >/dev/null 2>&1 || return 0
    save_original

    case "$profile" in
        balanced)
            reset_nvidia
            set_power_limit default
            ;;
        boost)
            lock_max_clocks
            set_power_limit default
            ;;
        burn)
            lock_max_clocks
            set_power_limit max
            ;;
        *)
            profile=boost
            lock_max_clocks
            set_power_limit default
            ;;
    esac

    log "applied NVIDIA profile $profile"
}

restore_original() {
    [ -f "$MARKER" ] || return 0
    command -v nvidia-smi >/dev/null 2>&1 || return 0

    reset_nvidia
    set_power_limit default
    rm -f "$STATE/orig-nv-power-limit" "$MARKER"
    log "restored NVIDIA auto clocks and default power limit"
}

case "${1:-apply}" in
    on|apply) apply_profile ;;
    off) restore_original ;;
    status) profile_name ;;
    *)
        echo "usage: $0 on|apply|off|status" >&2
        exit 2
        ;;
esac
